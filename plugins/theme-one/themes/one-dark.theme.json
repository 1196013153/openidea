// Atom One palette by GitHub Inc. (https://github.com/atom/one-dark-syntax and friends),
// MIT licence, see LICENSE. Adapted to OpenIDEA's tokens by bghtyu.
// UI theme; the editor colour scheme is in one-dark.scheme.json.
{
  "id": "one-dark",
  "name": "One Dark",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "hsl(220, 13%, 18%)",
    "--bg-elev": "hsl(220, 13%, 15%)",
    "--bg-popup": "hsl(220, 13%, 16.5%)",
    "--bg-hover": "hsl(220, 13%, 22%)",
    "--bg-selected": "hsl(220, 13%, 28%)",
    "--bg-selected-strong": "hsl(220, 13%, 28%)",
    "--bg-current-line": "color-mix(in srgb, hsl(220, 100%, 80%) 4%, hsl(220, 13%, 18%))",
    "--bg-debug-line": "color-mix(in srgb, hsl(207, 82%, 66%) 12%, hsl(220, 13%, 18%))",
    "--bg-backdrop": "hsl(220, 13%, 15%)",
    "--bg-input": "hsl(220, 13%, 18%)",

    // Lines
    "--border": "hsl(220, 13%, 10.8%)",
    "--border-popup": "hsl(220, 13%, 10.8%)",
    "--border-strong": "hsl(220, 9%, 55%)",
    "--border-window": "hsl(220, 13%, 10.8%)",
    "--control-off": "hsl(220, 9%, 55%)",

    // Text
    "--fg-strong": "hsl(220, 14%, 71%)",
    "--fg-emphasis": "hsl(220, 14%, 71%)",
    "--fg": "hsl(220, 14%, 71%)",
    "--fg-secondary": "hsl(220, 9%, 55%)",
    "--fg-muted": "hsl(220, 9%, 55%)",
    "--fg-subtle": "hsl(220, 9%, 55%)",
    "--fg-faint": "hsl(220, 9%, 55%)",
    "--fg-gutter": "hsl(220, 9%, 55%)",
    "--fg-icon": "hsl(220, 14%, 71%)",

    // Accent
    "--accent": "hsl(220, 100%, 66%)",
    "--link": "hsl(207, 82%, 66%)",
    "--link-hover": "hsl(187, 47%, 55%)",

    // Charts
    "--chart-series": "hsl(355, 65%, 65%)",

    // Status
    "--danger": "hsl(355, 65%, 65%)",
    "--warning": "hsl(39, 67%, 69%)",
    "--success": "hsl(95, 38%, 62%)",
    "--db-connected": "hsl(95, 38%, 62%)",
    "--db-connected-ring": "hsl(95, 38%, 62%)",
    "--info": "hsl(207, 82%, 66%)",

    // Vcs
    "--vcs-modified": "hsl(207, 82%, 66%)",
    "--vcs-added": "hsl(95, 38%, 62%)",
    "--vcs-deleted": "hsl(220, 9%, 55%)",
    "--vcs-untracked": "hsl(355, 65%, 65%)",
    "--vcs-ignored": "hsl(39, 67%, 69%)",
    "--vcs-conflict": "hsl(355, 65%, 65%)",
    "--gutter-modified": "hsl(207, 82%, 66%)",
    "--gutter-added": "hsl(95, 38%, 62%)",
    "--gutter-deleted": "hsl(355, 65%, 65%)",

    // Shadows and window controls
    "--shadow-popup": "0 4px 16px #00000024",
    "--shadow-dialog": "0 10px 36px #00000033",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "hsl(220, 13%, 22%)",
    "--traffic-off-border": "hsl(220, 13%, 10.8%)",

    // Additive
    "--bg-tooltip": "hsl(220, 13%, 16.5%)",
    "--fg-tooltip": "hsl(220, 14%, 71%)",
    "--border-tooltip": "hsl(220, 13%, 10.8%)",
    "--bg-control": "hsl(220, 13%, 18%)",
    "--bg-control-hover": "hsl(220, 13%, 22%)",
    "--bg-active": "hsl(220, 13%, 22%)",
    "--bg-scrim": "color-mix(in srgb, hsl(220, 13%, 18%) 68%, transparent)",
    "--fg-on-accent": "#000000",
    "--shadow-tooltip": "0 4px 16px #00000024",
    "--shadow-balloon": "0 10px 36px #00000033",

    // Islands contract
    "--bg-frame": "hsl(220, 13%, 15%)",
    "--bg-island": "hsl(220, 13%, 18%)",
    "--bg-stripe-hover": "hsl(220, 13%, 22%)",
    "--bg-stripe-selected": "hsl(220, 13%, 28%)",
    "--fg-stripe-selected-active": "#000000",
    "--fg-stripe-label": "hsl(220, 14%, 71%)",
    "--bg-tab-selected": "hsl(220, 13%, 28%)",
    "--border-tab-selected": "hsl(220, 100%, 66%)",
    "--bg-tab-selected-inactive": "hsl(220, 13%, 15%)",
    "--border-tab-selected-inactive": "hsl(220, 13%, 10.8%)",
    "--bg-tab-hover": "hsl(220, 13%, 22%)",
    "--border-editor-tabs": "hsl(220, 13%, 10.8%)",
    "--bg-tree-selected": "hsl(220, 13%, 28%)",
    "--bg-tree-selected-inactive": "hsl(220, 13%, 22%)",
    "--bg-tree-hover": "hsl(220, 13%, 22%)",
    "--bg-toolbar-hover": "hsl(220, 13%, 22%)",
    "--bg-toolbar-pressed": "hsl(220, 13%, 28%)",
    "--bg-toolbar-selected": "hsl(220, 13%, 28%)",
    "--bg-toolbar-selected-hover": "hsl(220, 13%, 28%)",
    "--bg-button-primary-hover": "color-mix(in srgb, var(--accent) 86%, hsl(220, 14%, 71%))",
    "--fg-button-primary": "#000000",
    "--bg-button": "hsl(220, 13%, 18%)",
    "--border-button": "hsl(220, 13%, 10.8%)",
    "--bg-field": "hsl(220, 13%, 18%)",
    "--bg-checkbox": "hsl(220, 13%, 18%)",
    "--border-checkbox": "hsl(220, 9%, 55%)",
    "--bg-toggle-on": "hsl(95, 38%, 62%)",
    "--fg-toggle-on": "#000000",
    "--bg-toggle-off": "hsl(220, 13%, 15%)",
    "--fg-toggle-off": "hsl(220, 14%, 71%)",
    "--border-toggle": "hsl(220, 9%, 55%)",
    "--bg-toggle-knob": "hsl(220, 9%, 55%)",
    "--focus-ring-soft": "hsl(220, 100%, 66%)",
    "--scrollbar-thumb": "color-mix(in srgb, hsl(220, 14%, 71%) 24%, transparent)",
    "--scrollbar-thumb-hover": "color-mix(in srgb, hsl(220, 14%, 71%) 42%, transparent)",
    "--bg-search-match": "color-mix(in srgb, hsl(39, 67%, 69%) 22%, hsl(220, 13%, 18%))",
    "--bg-search-match-current": "color-mix(in srgb, hsl(39, 67%, 69%) 36%, hsl(220, 13%, 18%))",
    "--fg-search-match": "hsl(220, 14%, 71%)",
    "--bg-dialog": "hsl(220, 13%, 18%)",
    "--bg-popup-inline": "hsl(220, 13%, 15%)",
    "--bg-popup-advertiser": "hsl(220, 13%, 15%)",
    "--bg-feedback-info": "color-mix(in srgb, hsl(207, 82%, 66%) 12%, hsl(220, 13%, 18%))",
    "--border-feedback-info": "color-mix(in srgb, hsl(207, 82%, 66%) 55%, hsl(220, 13%, 18%))",
    "--bg-feedback-error": "color-mix(in srgb, hsl(355, 65%, 65%) 12%, hsl(220, 13%, 18%))",
    "--border-feedback-error": "color-mix(in srgb, hsl(355, 65%, 65%) 55%, hsl(220, 13%, 18%))",
    "--bg-feedback-warning": "color-mix(in srgb, hsl(39, 67%, 69%) 12%, hsl(220, 13%, 18%))",
    "--border-feedback-warning": "color-mix(in srgb, hsl(39, 67%, 69%) 55%, hsl(220, 13%, 18%))",
    "--bg-feedback-success": "color-mix(in srgb, hsl(95, 38%, 62%) 12%, hsl(220, 13%, 18%))",
    "--border-feedback-success": "color-mix(in srgb, hsl(95, 38%, 62%) 55%, hsl(220, 13%, 18%))",
    "--bg-counter": "hsl(220, 100%, 66%)",
    "--fg-counter": "#000000",
    "--bg-progress-track": "hsl(220, 13%, 22%)"
  }
}
