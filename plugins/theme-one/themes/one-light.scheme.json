// Atom One palette by GitHub Inc. (https://github.com/atom/one-dark-syntax and friends),
// MIT licence, see LICENSE. Adapted to OpenIDEA's tokens by bghtyu.
// Editor colour scheme: syntax, editor surfaces and terminal ANSI colours.
{
  "name": "One Light",
  "tokens": {
    // Syntax
    "--syn-keyword": "hsl(301, 63%, 40%)",
    "--syn-string": "hsl(119, 34%, 47%)",
    "--syn-type": "hsl(41, 99%, 38%)",
    "--syn-function": "hsl(221, 87%, 60%)",
    "--syn-function-call": "hsl(221, 87%, 60%)",
    "--syn-comment": "hsl(230, 4%, 64%)",
    "--syn-comment-style": "italic",
    "--syn-doc-comment": "hsl(230, 4%, 64%)",
    "--syn-docstring": "hsl(119, 34%, 47%)",
    "--syn-annotation": "hsl(41, 99%, 30%)",
    "--syn-decorator": "hsl(41, 99%, 30%)",
    "--syn-number": "hsl(41, 99%, 30%)",
    "--syn-punct": "hsl(230, 8%, 24%)",
    "--syn-variable": "hsl(5, 74%, 59%)",
    "--syn-param": "hsl(230, 8%, 24%)",
    "--syn-property": "hsl(230, 8%, 24%)",
    "--syn-constant": "hsl(41, 99%, 30%)",
    "--syn-builtin": "hsl(198, 99%, 37%)",
    "--syn-self": "hsl(5, 74%, 59%)",
    "--syn-keyword-arg": "hsl(5, 74%, 59%)",
    "--syn-predefined": "hsl(198, 99%, 37%)",
    "--syn-escape": "hsl(198, 99%, 37%)",
    "--syn-regexp": "hsl(198, 99%, 37%)",
    "--syn-tag": "hsl(5, 74%, 59%)",
    "--syn-attribute": "hsl(41, 99%, 30%)",
    "--syn-todo": "hsl(301, 63%, 40%)",
    "--syn-link": "hsl(221, 87%, 60%)",
    "--syn-markup-heading": "hsl(221, 87%, 60%)",
    "--syn-markup-code": "hsl(119, 34%, 47%)",
    "--syn-invalid": "hsl(5, 74%, 59%)",
    "--syn-inline-value": "hsl(230, 6%, 44%)",
    "--syn-rainbow-1": "hsl(198, 99%, 37%)",
    "--syn-rainbow-2": "hsl(41, 99%, 30%)",
    "--syn-rainbow-3": "hsl(119, 34%, 47%)",
    "--syn-rainbow-4": "hsl(301, 63%, 40%)",
    "--syn-rainbow-5": "hsl(221, 87%, 60%)",
    "--syn-bracket-1": "hsl(41, 99%, 38%)",
    "--syn-bracket-2": "hsl(301, 63%, 40%)",
    "--syn-bracket-3": "hsl(221, 87%, 60%)",

    // Editor
    "--fg-editor": "hsl(230, 8%, 24%)",
    "--caret": "hsl(230, 100%, 66%)",
    "--fg-line-number": "hsl(230, 6%, 44%)",
    "--fg-line-number-current": "hsl(230, 8%, 24%)",
    "--border-gutter": "hsl(230, 1%, 86%)",
    "--border-indent-guide": "hsl(230, 1%, 86%)",
    "--border-indent-guide-active": "hsl(230, 100%, 66%)",
    "--border-right-margin": "hsl(230, 1%, 86%)",
    "--bg-editor-selection": "hsl(230, 1%, 90%)",
    "--bg-editor-selection-inactive": "hsl(230, 1%, 90%)",
    "--bg-text-search-result": "color-mix(in srgb, hsl(41, 99%, 38%) 22%, hsl(230, 1%, 98%))",
    "--bg-text-search-result-current": "color-mix(in srgb, hsl(41, 99%, 38%) 36%, hsl(230, 1%, 98%))",
    "--bg-matched-brace": "hsl(230, 1%, 90%)",
    "--matched-brace-weight": "var(--fw-code-bold)",
    "--bg-matched-tag": "hsl(230, 1%, 90%)",
    "--bg-fold-placeholder": "hsl(230, 1%, 92%)",
    "--fg-fold-placeholder": "hsl(230, 8%, 24%)",
    "--fg-fold-marker": "hsl(230, 6%, 44%)",
    "--fg-whitespace": "hsl(230, 6%, 44%)",
    "--fg-unused": "hsl(230, 6%, 44%)",
    "--bg-identifier-under-caret": "hsl(230, 1%, 90%)",
    "--bg-identifier-under-caret-write": "color-mix(in srgb, hsl(5, 74%, 59%) 12%, hsl(230, 1%, 98%))",
    "--fg-inlay": "hsl(230, 6%, 44%)",
    "--bg-inlay": "hsl(230, 1%, 92%)",
    "--wave-error": "hsl(5, 74%, 59%)",
    "--wave-warning": "hsl(41, 99%, 38%)",
    "--editor-error-decoration": "underline wavy var(--wave-error)",
    "--editor-warning-decoration": "underline wavy var(--wave-warning)",
    "--editor-warning-background": "color-mix(in srgb, hsl(41, 99%, 38%) 12%, hsl(230, 1%, 98%))",
    "--bg-breakpoint-line": "color-mix(in srgb, hsl(5, 74%, 59%) 12%, hsl(230, 1%, 98%))",
    "--fg-completion-match": "hsl(221, 87%, 60%)",
    "--bg-editor-inline": "hsl(230, 1%, 92%)",
    "--bg-editor-banner": "color-mix(in srgb, hsl(221, 87%, 60%) 12%, hsl(230, 1%, 98%))",
    "--fg-weak-warning": "hsl(230, 6%, 44%)",
    "--fg-bulb": "hsl(41, 99%, 38%)",

    // ANSI palette
    "--ansi-black": "hsl(230, 8%, 24%)",
    "--ansi-red": "hsl(5, 74%, 59%)",
    "--ansi-green": "hsl(119, 34%, 47%)",
    "--ansi-yellow": "hsl(41, 99%, 38%)",
    "--ansi-blue": "hsl(221, 87%, 60%)",
    "--ansi-magenta": "hsl(301, 63%, 40%)",
    "--ansi-cyan": "hsl(198, 99%, 37%)",
    "--ansi-white": "hsl(230, 6%, 44%)",
    "--ansi-bright-black": "hsl(230, 6%, 44%)",
    "--ansi-bright-red": "hsl(5, 74%, 59%)",
    "--ansi-bright-green": "hsl(119, 34%, 47%)",
    "--ansi-bright-yellow": "hsl(41, 99%, 38%)",
    "--ansi-bright-blue": "hsl(221, 87%, 60%)",
    "--ansi-bright-magenta": "hsl(301, 63%, 40%)",
    "--ansi-bright-cyan": "hsl(198, 99%, 37%)",
    "--ansi-bright-white": "hsl(230, 8%, 24%)"
  }
}
