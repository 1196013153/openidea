// Atom One palette by GitHub Inc. (https://github.com/atom/one-dark-syntax and friends),
// MIT licence, see LICENSE. Adapted to OpenIDEA's tokens by bghtyu.
// UI theme; the editor colour scheme is in one-light.scheme.json.
{
  "id": "one-light",
  "name": "One Light",
  "kind": "light",
  "tokens": {
    // Surfaces
    "--bg-app": "hsl(230, 1%, 98%)",
    "--bg-elev": "hsl(230, 1%, 92%)",
    "--bg-popup": "hsl(230, 1%, 95%)",
    "--bg-hover": "hsl(230, 1%, 90%)",
    "--bg-selected": "hsl(230, 1%, 90%)",
    "--bg-selected-strong": "hsl(230, 1%, 90%)",
    "--bg-current-line": "color-mix(in srgb, hsl(230, 8%, 24%) 5%, hsl(230, 1%, 98%))",
    "--bg-debug-line": "color-mix(in srgb, hsl(221, 87%, 60%) 12%, hsl(230, 1%, 98%))",
    "--bg-backdrop": "hsl(230, 1%, 92%)",
    "--bg-input": "hsl(230, 1%, 98%)",

    // Lines
    "--border": "hsl(230, 1%, 86%)",
    "--border-popup": "hsl(230, 1%, 86%)",
    "--border-strong": "hsl(230, 6%, 44%)",
    "--border-window": "hsl(230, 1%, 86%)",
    "--control-off": "hsl(230, 6%, 44%)",

    // Text
    "--fg-strong": "hsl(230, 8%, 24%)",
    "--fg-emphasis": "hsl(230, 8%, 24%)",
    "--fg": "hsl(230, 8%, 24%)",
    "--fg-secondary": "hsl(230, 6%, 44%)",
    "--fg-muted": "hsl(230, 6%, 44%)",
    "--fg-subtle": "hsl(230, 6%, 44%)",
    "--fg-faint": "hsl(230, 6%, 44%)",
    "--fg-gutter": "hsl(230, 6%, 44%)",
    "--fg-icon": "hsl(230, 8%, 24%)",

    // Accent
    "--accent": "hsl(230, 100%, 66%)",
    "--link": "hsl(221, 87%, 60%)",
    "--link-hover": "hsl(198, 99%, 37%)",

    // Charts
    "--chart-series": "hsl(5, 74%, 59%)",

    // Status
    "--danger": "hsl(5, 74%, 59%)",
    "--warning": "hsl(41, 99%, 38%)",
    "--success": "hsl(119, 34%, 47%)",
    "--db-connected": "hsl(119, 34%, 47%)",
    "--db-connected-ring": "hsl(119, 34%, 47%)",
    "--info": "hsl(221, 87%, 60%)",

    // Vcs
    "--vcs-modified": "hsl(221, 87%, 60%)",
    "--vcs-added": "hsl(119, 34%, 47%)",
    "--vcs-deleted": "hsl(230, 6%, 44%)",
    "--vcs-untracked": "hsl(5, 74%, 59%)",
    "--vcs-ignored": "hsl(41, 99%, 38%)",
    "--vcs-conflict": "hsl(5, 74%, 59%)",
    "--gutter-modified": "hsl(221, 87%, 60%)",
    "--gutter-added": "hsl(119, 34%, 47%)",
    "--gutter-deleted": "hsl(5, 74%, 59%)",

    // Shadows and window controls
    "--shadow-popup": "0 4px 16px #00000024",
    "--shadow-dialog": "0 10px 36px #00000033",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "hsl(230, 1%, 90%)",
    "--traffic-off-border": "hsl(230, 1%, 86%)",

    // Additive
    "--bg-tooltip": "hsl(230, 1%, 95%)",
    "--fg-tooltip": "hsl(230, 8%, 24%)",
    "--border-tooltip": "hsl(230, 1%, 86%)",
    "--bg-control": "hsl(230, 1%, 98%)",
    "--bg-control-hover": "hsl(230, 1%, 90%)",
    "--bg-active": "hsl(230, 1%, 90%)",
    "--bg-scrim": "color-mix(in srgb, hsl(230, 1%, 98%) 68%, transparent)",
    "--fg-on-accent": "#ffffff",
    "--shadow-tooltip": "0 4px 16px #00000024",
    "--shadow-balloon": "0 10px 36px #00000033",

    // Islands contract
    "--bg-frame": "hsl(230, 1%, 92%)",
    "--bg-island": "hsl(230, 1%, 98%)",
    "--bg-stripe-hover": "hsl(230, 1%, 90%)",
    "--bg-stripe-selected": "hsl(230, 1%, 90%)",
    "--fg-stripe-selected-active": "#ffffff",
    "--fg-stripe-label": "hsl(230, 8%, 24%)",
    "--bg-tab-selected": "hsl(230, 1%, 90%)",
    "--border-tab-selected": "hsl(230, 100%, 66%)",
    "--bg-tab-selected-inactive": "hsl(230, 1%, 92%)",
    "--border-tab-selected-inactive": "hsl(230, 1%, 86%)",
    "--bg-tab-hover": "hsl(230, 1%, 90%)",
    "--border-editor-tabs": "hsl(230, 1%, 86%)",
    "--bg-tree-selected": "hsl(230, 1%, 90%)",
    "--bg-tree-selected-inactive": "hsl(230, 1%, 90%)",
    "--bg-tree-hover": "hsl(230, 1%, 90%)",
    "--bg-toolbar-hover": "hsl(230, 1%, 90%)",
    "--bg-toolbar-pressed": "hsl(230, 1%, 90%)",
    "--bg-toolbar-selected": "hsl(230, 1%, 90%)",
    "--bg-toolbar-selected-hover": "hsl(230, 1%, 90%)",
    "--bg-button-primary-hover": "color-mix(in srgb, var(--accent) 86%, hsl(230, 8%, 24%))",
    "--fg-button-primary": "#ffffff",
    "--bg-button": "hsl(230, 1%, 98%)",
    "--border-button": "hsl(230, 1%, 86%)",
    "--bg-field": "hsl(230, 1%, 98%)",
    "--bg-checkbox": "hsl(230, 1%, 98%)",
    "--border-checkbox": "hsl(230, 6%, 44%)",
    "--bg-toggle-on": "hsl(119, 34%, 47%)",
    "--fg-toggle-on": "#ffffff",
    "--bg-toggle-off": "hsl(230, 1%, 92%)",
    "--fg-toggle-off": "hsl(230, 8%, 24%)",
    "--border-toggle": "hsl(230, 6%, 44%)",
    "--bg-toggle-knob": "hsl(230, 6%, 44%)",
    "--focus-ring-soft": "hsl(230, 100%, 66%)",
    "--scrollbar-thumb": "color-mix(in srgb, hsl(230, 8%, 24%) 24%, transparent)",
    "--scrollbar-thumb-hover": "color-mix(in srgb, hsl(230, 8%, 24%) 42%, transparent)",
    "--bg-search-match": "color-mix(in srgb, hsl(41, 99%, 38%) 22%, hsl(230, 1%, 98%))",
    "--bg-search-match-current": "color-mix(in srgb, hsl(41, 99%, 38%) 36%, hsl(230, 1%, 98%))",
    "--fg-search-match": "hsl(230, 8%, 24%)",
    "--bg-dialog": "hsl(230, 1%, 98%)",
    "--bg-popup-inline": "hsl(230, 1%, 92%)",
    "--bg-popup-advertiser": "hsl(230, 1%, 92%)",
    "--bg-feedback-info": "color-mix(in srgb, hsl(221, 87%, 60%) 12%, hsl(230, 1%, 98%))",
    "--border-feedback-info": "color-mix(in srgb, hsl(221, 87%, 60%) 55%, hsl(230, 1%, 98%))",
    "--bg-feedback-error": "color-mix(in srgb, hsl(5, 74%, 59%) 12%, hsl(230, 1%, 98%))",
    "--border-feedback-error": "color-mix(in srgb, hsl(5, 74%, 59%) 55%, hsl(230, 1%, 98%))",
    "--bg-feedback-warning": "color-mix(in srgb, hsl(41, 99%, 38%) 12%, hsl(230, 1%, 98%))",
    "--border-feedback-warning": "color-mix(in srgb, hsl(41, 99%, 38%) 55%, hsl(230, 1%, 98%))",
    "--bg-feedback-success": "color-mix(in srgb, hsl(119, 34%, 47%) 12%, hsl(230, 1%, 98%))",
    "--border-feedback-success": "color-mix(in srgb, hsl(119, 34%, 47%) 55%, hsl(230, 1%, 98%))",
    "--bg-counter": "hsl(230, 100%, 66%)",
    "--fg-counter": "#ffffff",
    "--bg-progress-track": "hsl(230, 1%, 90%)"
  }
}
