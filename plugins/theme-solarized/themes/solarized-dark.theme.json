// Solarized palette by Ethan Schoonover (https://github.com/altercation/solarized),
// MIT licence, see LICENSE. Adapted to OpenIDEA's tokens by bghtyu.
// UI theme; the editor colour scheme is in solarized-dark.scheme.json.
{
  "id": "solarized-dark",
  "name": "Solarized Dark",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#002b36",
    "--bg-elev": "#073642",
    "--bg-popup": "#073642",
    "--bg-hover": "#073642",
    "--bg-selected": "#073642",
    "--bg-selected-strong": "#073642",
    "--bg-current-line": "#073642",
    "--bg-debug-line": "color-mix(in srgb, #268bd2 12%, #002b36)",
    "--bg-backdrop": "#073642",
    "--bg-input": "#002b36",

    // Lines
    "--border": "#073642",
    "--border-popup": "#073642",
    "--border-strong": "#839496",
    "--border-window": "#073642",
    "--control-off": "#839496",

    // Text
    "--fg-strong": "#839496",
    "--fg-emphasis": "#839496",
    "--fg": "#839496",
    "--fg-secondary": "#839496",
    "--fg-muted": "#839496",
    "--fg-subtle": "#839496",
    "--fg-faint": "#839496",
    "--fg-gutter": "#839496",
    "--fg-icon": "#839496",

    // Accent
    "--accent": "#268bd2",
    "--link": "#268bd2",
    "--link-hover": "#2aa198",

    // Charts
    "--chart-series": "#dc322f",

    // Status
    "--danger": "#dc322f",
    "--warning": "#b58900",
    "--success": "#859900",
    "--db-connected": "#859900",
    "--db-connected-ring": "#859900",
    "--info": "#268bd2",

    // Vcs
    "--vcs-modified": "#268bd2",
    "--vcs-added": "#859900",
    "--vcs-deleted": "#839496",
    "--vcs-untracked": "#dc322f",
    "--vcs-ignored": "#b58900",
    "--vcs-conflict": "#dc322f",
    "--gutter-modified": "#268bd2",
    "--gutter-added": "#859900",
    "--gutter-deleted": "#dc322f",

    // Shadows and window controls
    "--shadow-popup": "0 4px 16px #00000024",
    "--shadow-dialog": "0 10px 36px #00000033",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#073642",
    "--traffic-off-border": "#073642",

    // Additive
    "--bg-tooltip": "#073642",
    "--fg-tooltip": "#839496",
    "--border-tooltip": "#073642",
    "--bg-control": "#002b36",
    "--bg-control-hover": "#073642",
    "--bg-active": "#073642",
    "--bg-scrim": "color-mix(in srgb, #002b36 68%, transparent)",
    "--fg-on-accent": "#002b36",
    "--shadow-tooltip": "0 4px 16px #00000024",
    "--shadow-balloon": "0 10px 36px #00000033",

    // Islands contract
    "--bg-frame": "#073642",
    "--bg-island": "#002b36",
    "--bg-stripe-hover": "#073642",
    "--bg-stripe-selected": "#073642",
    "--fg-stripe-selected-active": "#002b36",
    "--fg-stripe-label": "#839496",
    "--bg-tab-selected": "#073642",
    "--border-tab-selected": "#268bd2",
    "--bg-tab-selected-inactive": "#073642",
    "--border-tab-selected-inactive": "#073642",
    "--bg-tab-hover": "#073642",
    "--border-editor-tabs": "#073642",
    "--bg-tree-selected": "#073642",
    "--bg-tree-selected-inactive": "#073642",
    "--bg-tree-hover": "#073642",
    "--bg-toolbar-hover": "#073642",
    "--bg-toolbar-pressed": "#073642",
    "--bg-toolbar-selected": "#073642",
    "--bg-toolbar-selected-hover": "#073642",
    "--bg-button-primary-hover": "color-mix(in srgb, var(--accent) 86%, #839496)",
    "--fg-button-primary": "#002b36",
    "--bg-button": "#002b36",
    "--border-button": "#073642",
    "--bg-field": "#002b36",
    "--bg-checkbox": "#002b36",
    "--border-checkbox": "#839496",
    "--bg-toggle-on": "#859900",
    "--fg-toggle-on": "#002b36",
    "--bg-toggle-off": "#073642",
    "--fg-toggle-off": "#839496",
    "--border-toggle": "#839496",
    "--bg-toggle-knob": "#839496",
    "--focus-ring-soft": "#268bd2",
    "--scrollbar-thumb": "color-mix(in srgb, #839496 24%, transparent)",
    "--scrollbar-thumb-hover": "color-mix(in srgb, #839496 42%, transparent)",
    "--bg-search-match": "color-mix(in srgb, #b58900 22%, #002b36)",
    "--bg-search-match-current": "color-mix(in srgb, #b58900 36%, #002b36)",
    "--fg-search-match": "#839496",
    "--bg-dialog": "#002b36",
    "--bg-popup-inline": "#073642",
    "--bg-popup-advertiser": "#073642",
    "--bg-feedback-info": "color-mix(in srgb, #268bd2 12%, #002b36)",
    "--border-feedback-info": "color-mix(in srgb, #268bd2 55%, #002b36)",
    "--bg-feedback-error": "color-mix(in srgb, #dc322f 12%, #002b36)",
    "--border-feedback-error": "color-mix(in srgb, #dc322f 55%, #002b36)",
    "--bg-feedback-warning": "color-mix(in srgb, #b58900 12%, #002b36)",
    "--border-feedback-warning": "color-mix(in srgb, #b58900 55%, #002b36)",
    "--bg-feedback-success": "color-mix(in srgb, #859900 12%, #002b36)",
    "--border-feedback-success": "color-mix(in srgb, #859900 55%, #002b36)",
    "--bg-counter": "#268bd2",
    "--fg-counter": "#002b36",
    "--bg-progress-track": "#073642"
  }
}
